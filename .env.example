# --- Server ---
PORT=8080
# Public URL of this Beacon instance. Used to build magic-link URLs in emails.
# Must be set even in local dev.
BASE_URL=http://localhost:8080

# --- Storage ---
DB_PATH=./data/beacon.db
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Comma-separated allowlist of emails that can sign in to the web UI.
ROOT_EMAILS=you@example.com
# Random 32+ byte secret used for signing CSRF tokens. Rotate to invalidate forms.
SESSION_SECRET=change-me-to-32-random-bytes
MAGIC_LINK_TTL=15m
SESSION_TTL=15d
# Set to true in production (HTTPS only). Leave false for local http dev.
COOKIE_SECURE=false

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender on your Resend account.
EMAIL_FROM=beacon@yourdomain.com

# --- Email queue ---
EMAIL_RETRY_ATTEMPTS=3
